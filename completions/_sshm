#compdef sshm

_sshm_nodes() {
    local conf="${SSH_MANAGER_CONFIG:-${HOME}/.config/ssh-manager/config.yaml}"
    [[ -f /etc/ssh-manager/config.yaml ]] && conf="/etc/ssh-manager/config.yaml"
    [[ -f "$conf" ]] || return 1
    grep -E '^\s*-?\s*name:\s*' "$conf" 2>/dev/null | sed 's/.*name:\s*//;s/^"//;s/"$//;s/^'\''//;s/'\''$//'
}

_sshm() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -s \
        '(--help -h)'{--help,-h}'[Show help message]' \
        '(--version -v)'{--version,-v}'[Show version information]' \
        '--config[Use specified config file]:config file:_files' \
        '*:node name:->nodes'

    case "$state" in
        nodes)
            local -a node_list
            node_list=($(_sshm_nodes))
            _describe 'node name' node_list
            ;;
    esac
}

_sshm "$@"
